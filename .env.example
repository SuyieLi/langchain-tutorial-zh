# ===== LangChain 教程 .env 模板 =====
# 用法: 复制本文件为 .env，并填入你自己的值
#   Windows PowerShell:  copy .env.example .env
#   macOS / Linux:       cp .env.example .env
# 注意: .env 已加入 .gitignore，千万不要把真实密钥提交到仓库!

# 你的模型服务商密钥（DeepSeek / OpenAI 通用字段名）
API_KEY=sk-你的密钥

# 模型名
MODEL_NAME=deepseek-chat

# langchain provider。DeepSeek 兼容 OpenAI 协议，这里填 openai 即可
MODEL_PROVIDER=openai

# 兼容 OpenAI 的 API 基地址
#   DeepSeek:  https://api.deepseek.com/v1
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI:    https://api.openai.com/v1
BASE_URL=https://api.deepseek.com/v1

# ===== 其它可选配置（按需取消注释） =====
# 本地 Ollama（免费、离线、无需任何 API_KEY）:
#   使用前需: 1) 安装 Ollama 桌面程序  2) 终端执行 `ollama pull qwen2.5:7b` 拉取模型
#   然后按下述三行启用（注释掉上面的 DeepSeek 四行）:
# MODEL_NAME=qwen2.5:7b
# MODEL_PROVIDER=ollama
# BASE_URL=http://localhost:11434
# API_KEY=
